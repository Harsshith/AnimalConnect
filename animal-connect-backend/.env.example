# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/animal_connect

# JWT Authentication
JWT_SECRET=super_secret_animal_connect_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# File Upload Storage (local or cloudinary)
STORAGE_TYPE=local
UPLOAD_PATH=uploads

# Cloudinary (Optional - Required only if STORAGE_TYPE=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Initial Admin Creation (Used by createAdmin script)
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_EMAIL=admin@animalconnect.org
INITIAL_ADMIN_PHONE=+919876543210
INITIAL_ADMIN_PASSWORD=AdminPass@2026!
